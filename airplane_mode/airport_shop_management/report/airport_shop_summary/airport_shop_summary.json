 "prepared_report": 0,
 "query": "SELECT\n a.name AS `Airport:Link/Airport:150`,\n COUNT(s.name) AS `Total Shops:Int:110`,\n COALESCE(SUM(s.status = 'Available'), 0) AS `Available:Int:100`,\n COALESCE(SUM(s.status = 'Occupied'), 0) AS `Occupied:Int:100`\nFROM `tabAirport` a\nLEFT JOIN `tabShop` s ON s.airport = a.name\nGROUP BY a.name\nORDER BY a.name",
