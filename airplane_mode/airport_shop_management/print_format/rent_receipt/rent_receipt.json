 "font_size": 14,
 "html": "<div style=\"max-width: 600px; margin: 0 auto; font-family: sans-serif;\">\n    <h2 style=\"text-align: center;\">Rent Receipt</h2>\n    <p style=\"text-align: center;\">Receipt No: {{ doc.name }}</p>\n    <hr>\n    <table style=\"width: 100%; line-height: 1.8;\">\n        <tr><td>Received from</td><td><b>{{ doc.tenant_name }}</b></td></tr>\n        <tr>\n            <td>Shop</td>\n            <td>{{ frappe.db.get_value(\"Shop\", doc.shop, \"shop_name\") }} ({{ doc.shop }})</td>\n        </tr>\n        <tr><td>Rent for</td><td>{{ doc.for_month }} {{ doc.for_year }}</td></tr>\n        <tr><td>Amount</td><td><b>{{ doc.get_formatted(\"amount\") }}</b></td></tr>\n        <tr><td>Paid on</td><td>{{ frappe.utils.format_date(doc.payment_date, \"d MMMM, YYYY\") }}</td></tr>\n        <tr><td>Mode of payment</td><td>{{ doc.mode_of_payment or \"-\" }}</td></tr>\n    </table>\n    <hr>\n    <p style=\"text-align: right;\">Authorised signature</p>\n</div>",
